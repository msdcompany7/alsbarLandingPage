# Website database (separate schema from OMS — use dedicated DB in production)
WEBSITE_DATABASE_URL="postgresql://electricity_shop:electricity_shop_secret@localhost:5432/electricity_shop?schema=website"

# Auth
AUTH_SECRET="change-me-website-auth-secret-min-32-characters-long"
AUTH_URL="http://localhost:3002"

# Email (optional — inquiries still saved to DB without this)
RESEND_API_KEY=""
WEBSITE_INQUIRY_EMAIL="info@electricity-shop.co.il"
WEBSITE_FROM_EMAIL="onboarding@resend.dev"

# Cloudinary (optional — admin can paste image URLs without this)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public site URL (used in sitemap/robots)
NEXT_PUBLIC_SITE_URL="https://electricity-shop.co.il"
